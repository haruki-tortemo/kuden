# Copy to .env at the top of the repository and fill in, then run with:
#   node --env-file=.env src/cli.ts ...
# Or keep each key in ~/.secrets/anthropic.env and ~/.secrets/openai.env.
# .env is ignored by git. Never commit a key.

# Claude: storyboard, interviewer, review, translation
ANTHROPIC_API_KEY=
# Image model: panels and reference sheets. Not needed with --placeholder.
OPENAI_API_KEY=

# Optional. Leave unset for the defaults.
# CLAUDE_MODEL=
# CLAUDE_MODEL_LIGHT=
# OPENAI_IMAGE_MODEL=
# SECRETS_DIR=
